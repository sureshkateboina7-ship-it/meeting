SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
SMTP_USE_TLS=true
SMTP_APP_NAME=no-helmet
AUTO_EMAIL_RECIPIENT=

INFERENCE_SIZE=640
PLATE_MODEL_URL=https://huggingface.co/Koushim/yolov8-license-plate-detection/resolve/main/best.pt
ALPR_ENGINE=auto
FAST_ALPR_DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end
FAST_ALPR_OCR_MODEL=cct-s-v2-global-model
IMAGE_CONFIDENCE=0.30
PLATE_CONFIDENCE=0.35
LIVE_CONFIDENCE=0.25
FRAME_SKIP=1
DUPLICATE_COOLDOWN_SEC=5

RIDER_LABELS=rider,person,motorcyclist,biker
MOTORCYCLE_LABELS=motorcycle,bike,motorbike,scooter
NO_HELMET_LABELS=no-hardhat,nohardhat,no_helmet,without_helmet,withouthelmet,nohelmet,unhelmeted
HELMET_LABELS=hardhat,helmet,with_helmet

OCR_LANGUAGES=en
OCR_GPU=false
